.env
data/*
# The curated override table is a deliverable, not downloaded data. Git cannot
# re-include a file under an excluded directory, so the exclusion is spelled out
# level by level.
!data/overrides/
data/overrides/*
!data/overrides/*.csv
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
node_modules/
*.parquet
*.duckdb
.venv/
.DS_Store
