# ---- Django ----
DJANGO_SETTINGS_MODULE=signaldesk.web.config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=signaldesk
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=signaldesk

# ---- Redis and Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Paths inside the container ----
DATA_DIR=/data
CACHE_DIR=/data/cache
MODEL_DIR=/data/models

# ---- Ingest ----
FAERS_START_QUARTER=2012Q4
OPENFDA_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
HTTP_USER_AGENT=signaldesk/0.1 (+https://github.com/hassanzaibhay/signaldesk)

# ---- Retrieval ----
EMBEDDING_MODEL=ncbi/MedCPT-Article-Encoder
QUERY_ENCODER_MODEL=ncbi/MedCPT-Query-Encoder
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
ABLATION_DENSE_MODEL=BAAI/bge-m3
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
RERANK_TOP_K=8
HNSW_EF_SEARCH=100
CONTEXT_TOKEN_BUDGET=6000

# ---- Model router, ordered failover ----
LLM_PROVIDER_CHAIN=gemini,groq,cerebras,ollama
LLM_GENERATION_MODEL=gemini-2.5-flash
LLM_JUDGE_PROVIDER=groq
LLM_JUDGE_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=90

# ---- Agent budgets ----
AGENT_MAX_STEPS=6
AGENT_MAX_CALLS_PER_TOOL=2
AGENT_WALL_CLOCK_SECONDS=45
