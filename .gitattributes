* text=auto eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.jinja    text eol=lf
*.sql      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf
*.png      binary

# Vendored, minified third-party bundles. Marked binary so git does not diff
# them line by line and so the ASCII gate does not scan them: they are build
# output from another project, not content this repository writes, and the
# Plotly bundle legitimately carries non-ASCII characters in its own strings.
*.min.js   binary

*.parquet  binary
*.zip      binary

# Fixtures are byte-exact copies of published extracts. Some of them use CRLF
# and some LF, sometimes within one archive, and the reader is tested against
# exactly that. Normalising line endings on checkout would quietly remove the
# property the fixture exists to prove.
tests/fixtures/** -text
